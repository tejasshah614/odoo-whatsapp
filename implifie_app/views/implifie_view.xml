<odoo>
    <data>
        <!-- Tree View for Trigger -->
        <record id="view_trigger_action_tree" model="ir.ui.view">
            <field name="name">trigger.action.tree</field>
            <field name="model">trigger.action</field>
            <field name="arch" type="xml">
                <list string="Trigger Actions">
                    <field name="app_id" />
                    <field name="model_id" />
                    <field name="event" />
                    <field name="template_name" />
                    <field name="active" />
                    <field name="language" />

                </list>
            </field>
        </record>

        <!-- Form View for Trigger -->
        
        <!-- Tree View for Trigger Actions -->
        

        <!-- Form View for Trigger Actions -->
        <record id="view_trigger_action_form" model="ir.ui.view">
            <field name="name">trigger.action.form</field>
            <field name="model">trigger.action</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="app_id" />
                            <field name="model_id" />
                            <field name="event" />
                            <field name="template_name" widget="selection" 
                           options="{'no_create': True}" />
                            <field name="active" />
                            
                        </group>
                    </sheet>
                </form>
            </field>
        </record>


          <record id="action_trigger_action" model="ir.actions.act_window">
        <field name="name">Trigger Actions</field>
        <field name="res_model">trigger.action</field>
        <field name="view_mode">list,form</field>
            </record>

        <!-- Action for Triggers -->
       

        <!-- Action for Trigger Actions -->
        
    </data>
</odoo>



